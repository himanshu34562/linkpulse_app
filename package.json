{
  "name": "linkpulse",
  "private": true,
  "version": "0.1.0",
  "description": "Link shortener with a real-time analytics pipeline, built stage by stage to study system design.",
  "scripts": {
    "dev:api": "pnpm --filter @linkpulse/api dev",
    "dev:web": "pnpm --filter @linkpulse/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @linkpulse/api migrate",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0"
}
